    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "webpack": "^5.11.1",
    "webpack-cli": "^4.3.1"
  }
