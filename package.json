{
  "name": "@modernized/echarts-wordcloud",
  "version": "4.0.0",
  "description": "ECharts wordcloud extension based on wordcloud2.js",
  "keywords": [
    "echarts",
    "wordcloud",
    "word-cloud",
    "wordcloud2",
    "chart",
    "visualization"
  ],
  "homepage": "https://github.com/modernized-js/echarts-wordcloud#readme",
  "bugs": {
    "url": "https://github.com/modernized-js/echarts-wordcloud/issues"
  },
  "main": "./dist/echarts-wordcloud.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build --mode esm && vite build --mode umd && vite build --mode umd-min && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "node --test test/test_*.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "echarts": "^6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modernized-js/echarts-wordcloud.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "echarts": "^6.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "module": "./dist/echarts-wordcloud.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/echarts-wordcloud.mjs",
      "require": "./dist/echarts-wordcloud.js",
      "default": "./dist/echarts-wordcloud.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@1.22.22"
}
