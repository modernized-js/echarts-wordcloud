{
  "name": "echarts-wordcloud",
  "version": "2.1.0",
  "description": "ECharts wordcloud extension based on wordcloud2.js",
  "type": "module",
  "main": "./dist/echarts-wordcloud.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "echarts": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ecomfe/echarts-wordcloud.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "echarts": "^5.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "module": "./dist/echarts-wordcloud.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/echarts-wordcloud.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ]
}
